+    #[test]
+    fn replace_many_validation_failure_changes_nothing() {
+        let (state, p1) = state! {
+            doc { root { p1: paragraph { text("hello hello") } } }
+            selection: (p1, 0)
+        };
+        let mut editor = Editor::new_test(state);
+        editor.apply(add_op(
+            "second",
+            editor_state::Selection::new(
+                editor_state::Position::new(p1, 6),
+                editor_state::Position::new(p1, 11),
+            ),
+        ));
+        editor.apply(add_op(
+            "first",
+            editor_state::Selection::new(
+                editor_state::Position::new(p1, 0),
+                editor_state::Position::new(p1, 5),
+            ),
+        ));
+
+        let before_heads = editor.current_heads();
+        let before_undos = editor.history_undos_len();
+        let request = editor.enqueue_request(vec![replace_many(
+            "hello hello",
+            vec![
+                ("second", 6, 11, "stale", "world"),
+                ("first", 0, 5, "hello", "hi"),
+            ],
+        )]).expect("queued replacement request");
+        let result = editor.tick_through(request).expect("invalid batch is nonfatal");
+        assert!(result.events.iter().all(|event| matches!(
+            event,
+            EditorEvent::TrackedRangeReplaceResult {
+                outcome: TrackedRangeReplaceOutcome::Invalid,
+                ..
+            }
+        )));
+        assert_eq!(
+            editor_state::prose(&editor.state().view()).text(),
+            "hello hello"
+        );
+        assert_eq!(editor.current_heads(), before_heads);
+        assert_eq!(editor.history_undos_len(), before_undos);
+    }
