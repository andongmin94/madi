+    #[test]
+    fn replace_many_is_atomic_and_one_undo_entry() {
+        let (state, p1) = state! {
+            doc { root { p1: paragraph { text("hello hello") [italic] } } }
+            selection: (p1, 0)
+        };
+        let mut editor = Editor::new_test(state);
+        editor.apply(add_op(
+            "second",
+            editor_state::Selection::new(
+                editor_state::Position::new(p1, 6),
+                editor_state::Position::new(p1, 11),
+            ),
+        ));
+        editor.apply(add_op(
+            "first",
+            editor_state::Selection::new(
+                editor_state::Position::new(p1, 0),
+                editor_state::Position::new(p1, 5),
+            ),
+        ));
+
+        let before_undos = editor.history_undos_len();
+        let events = editor.apply(replace_many("hello hello", vec![
+            ("second", 6, 11, "hello", "world"),
+            ("first", 0, 5, "hello", "hi"),
+        ]));
+        assert_eq!(
+            editor_state::prose(&editor.state().view()).text(),
+            "hi world"
+        );
+        assert_eq!(editor.history_undos_len(), before_undos + 1);
+        assert_eq!(
+            events
+                .iter()
+                .filter(|event| matches!(
+                    event,
+                    EditorEvent::TrackedRangeReplaceResult {
+                        outcome: TrackedRangeReplaceOutcome::Replaced,
+                        ..
+                    }
+                ))
+                .count(),
+            2
+        );
+
+        editor.apply(Message::History {
+            op: HistoryOp::Undo,
+        });
+        assert_eq!(
+            editor_state::prose(&editor.state().view()).text(),
+            "hello hello"
+        );
+        editor.apply(Message::History {
+            op: HistoryOp::Redo,
+        });
+        assert_eq!(editor_state::prose(&editor.state().view()).text(), "hi world");
+    }
