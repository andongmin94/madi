+fn handle_replace_many_from_prose_annotated(
+    editor: &mut Editor,
+    expected_text: String,
+    replacements: Vec<ProseTextReplacement>,
+) -> Result<(), EditorError> {
+    let ids = replacements
+        .iter()
+        .map(|replacement| replacement.id.clone())
+        .collect::<Vec<_>>();
+    let outcome = match try_replace_many_from_prose_annotated(
+        editor,
+        expected_text,
+        replacements,
+    ) {
+        Ok(()) => TrackedRangeReplaceOutcome::Replaced,
+        Err(_) => TrackedRangeReplaceOutcome::Invalid,
+    };
+    for id in ids {
+        editor.push_event(EditorEvent::TrackedRangeReplaceResult {
+            id,
+            outcome: outcome.clone(),
+        });
+    }
+    Ok(())
+}
+
+fn try_replace_many_from_prose_annotated(
+    editor: &mut Editor,
+    expected_text: String,
+    mut replacements: Vec<ProseTextReplacement>,
+) -> Result<(), EditorError> {
+    if editor.state().composition.is_some() {
+        return Err(EditorError::General {
+            msg: "TrackedRange::ReplaceManyFromProseAnnotated: composition is active".into(),
+        });
+    }
+    if replacements.is_empty() {
+        return Err(EditorError::General {
+            msg: "TrackedRange::ReplaceManyFromProseAnnotated: replacements must not be empty"
+                .into(),
+        });
+    }
+    let mut ids = HashSet::new();
+    if replacements
+        .iter()
+        .any(|replacement| !ids.insert(replacement.id.clone()))
+    {
+        return Err(EditorError::General {
+            msg: "TrackedRange::ReplaceManyFromProseAnnotated: ids must be unique".into(),
+        });
+    }
+
+    replacements.sort_by(|left, right| {
+        right
+            .start
+            .cmp(&left.start)
+            .then_with(|| right.end.cmp(&left.end))
+    });
+    let view = editor.state().view();
+    let prose = editor_state::prose_annotated(&view);
+    if prose.text() != expected_text {
+        return Err(EditorError::General {
+            msg: "TrackedRange::ReplaceManyFromProseAnnotated: document text mismatch".into(),
+        });
+    }
+    let prose_chars: Vec<char> = expected_text.chars().collect();
+    let mut next_start = prose_chars.len();
+    let mut prepared = Vec::with_capacity(replacements.len());
+    for replacement in replacements {
+        let start = replacement.start as usize;
+        let end = replacement.end as usize;
+        if start >= end
+            || end > prose_chars.len()
+            || end > next_start
+            || replacement.expected_text.contains(['\r', '\n'])
+            || replacement.replacement.contains(['\r', '\n'])
+            || prose_chars[start..end].iter().collect::<String>() != replacement.expected_text
+        {
+            return Err(EditorError::General {
+                msg: format!(
+                    "TrackedRange::ReplaceManyFromProseAnnotated: invalid range {}",
+                    replacement.id
+                ),
+            });
+        }
+        let selection = prose
+            .to_selection(&view, start..end)
+            .and_then(|selection| selection.resolve(&view).map(|resolved| (selection, resolved)))
+            .ok_or_else(|| EditorError::General {
+                msg: format!(
+                    "TrackedRange::ReplaceManyFromProseAnnotated: unmappable range {}",
+                    replacement.id
+                ),
+            })?;
+        let (selection, resolved) = selection;
+        if resolved.is_collapsed() || resolved.from().node() != resolved.to().node() {
+            return Err(EditorError::General {
+                msg: format!(
+                    "TrackedRange::ReplaceManyFromProseAnnotated: cross-block range {}",
+                    replacement.id
+                ),
+            });
+        }
+        use editor_state::ResolvedPositionFlatExt;
+        let flat_range = resolved.from().to_flat()..resolved.to().to_flat();
+        let segments = editor_state::flat_segments_in_range(&view, flat_range.clone());
+        if editor_state::flat_text(&view, flat_range) != replacement.expected_text
+            || !segments
+                .iter()
+                .all(|segment| matches!(segment, editor_state::FlatSegment::Text { .. }))
+        {
+            return Err(EditorError::General {
+                msg: format!(
+                    "TrackedRange::ReplaceManyFromProseAnnotated: non-text range {}",
+                    replacement.id
+                ),
+            });
+        }
+        let mut first_leaf = None::<editor_crdt::Dot>;
+        let mut mixed_modifiers = false;
+        for segment in &segments {
+            let editor_state::FlatSegment::Text { leaves, .. } = segment else {
+                continue;
+            };
+            for leaf in leaves {
+                let leaf_state = view.leaf_state_by_dot_slow(*leaf).ok_or_else(|| {
+                    EditorError::General {
+                        msg: format!(
+                            "TrackedRange::ReplaceManyFromProseAnnotated: unresolved modifiers {}",
+                            replacement.id
+                        ),
+                    }
+                })?;
+                if let Some(first_leaf) = first_leaf {
+                    let first = view.leaf_state_by_dot_slow(first_leaf).ok_or_else(|| {
+                        EditorError::General {
+                            msg: format!(
+                                "TrackedRange::ReplaceManyFromProseAnnotated: unresolved modifiers {}",
+                                replacement.id
+                            ),
+                        }
+                    })?;
+                    if leaf_state.eff != first.eff || leaf_state.own != first.own {
+                        mixed_modifiers = true;
+                    }
+                } else {
+                    first_leaf = Some(*leaf);
+                }
+            }
+        }
+        if mixed_modifiers || first_leaf.is_none() {
+            return Err(EditorError::General {
+                msg: format!(
+                    "TrackedRange::ReplaceManyFromProseAnnotated: mixed modifiers {}",
+                    replacement.id
+                ),
+            });
+        }
+        next_start = start;
+        prepared.push((replacement, selection));
+    }
+    drop(view);
+
+    let pre_state = editor.state().clone();
+    let pre_selection = pre_state.selection.map(|selection| {
+        StableSelection::capture(&selection, &pre_state.view())
+    });
+    let pre_pending_modifiers = pre_state.pending_modifiers.clone();
+    editor.transact(move |tr| {
+        tr.clear_pending_format()?;
+        for (replacement, selection) in &prepared {
+            let changed =
+                commands::replace_tracked_range(tr, *selection, &replacement.replacement)?;
+            if !changed {
+                return Err(EditorError::General {
+                    msg: format!(
+                        "TrackedRange::ReplaceManyFromProseAnnotated: replacement {} produced no change",
+                        replacement.id
+                    ),
+                });
+            }
+        }
+        match &pre_selection {
+            None => tr.set_selection(None)?,
+            Some(selection) => {
+                tr.projected_clean().map_err(|error| EditorError::General {
+                    msg: format!(
+                        "TrackedRange::ReplaceManyFromProseAnnotated: projection failed: {error}"
+                    ),
+                })?;
+                let remapped = {
+                    let view = tr.view();
+                    let ctx = editor_state::StableResolveCtx::from_live(
+                        &view,
+                        tr.state().projected.seq_checkout(),
+                    );
+                    selection.resolve(&ctx).ok_or_else(|| EditorError::General {
+                        msg: "TrackedRange::ReplaceManyFromProseAnnotated: selection remap failed"
+                            .into(),
+                    })?
+                };
+                tr.set_selection(Some(remapped))?;
+            }
+        }
+        tr.set_pending_modifiers(pre_pending_modifiers)?;
+        tr.keep_pending_modifiers();
+        Ok(())
+    })?;
+
+    Ok(())
+}
