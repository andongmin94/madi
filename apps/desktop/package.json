{
  "name": "@madi/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first Electron authoring desktop for madi",
  "main": "dist/electron/main/index.js",
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:preload": "vite build -c vite.preload.config.ts",
    "build:renderer": "vite build",
    "dev": "pnpm run build:main && pnpm run build:preload && concurrently -k -s first \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && cross-env MADI_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@madi/typie-runtime": "workspace:*",
    "@xyflow/react": "12.11.2",
    "cytoscape": "3.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  }
}
