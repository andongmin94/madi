name: Apply Phase 1I-H-A
run-name: Apply Phase 1I-H-A — ${{ github.sha }}

on:
  push:
    branches:
      - main
    paths:
      - .github/workflows/apply-phase1i-h-a.yml
      - .github/phase1i-h-a/**

permissions:
  contents: write
  actions: write

concurrency:
  group: phase1i-h-a-main
  cancel-in-progress: false

jobs:
  apply:
    name: Apply and verify snapshot-gated multi-block AI editing
    runs-on: windows-latest
    timeout-minutes: 240

    steps:
      - name: Keep repository text files on LF
        shell: pwsh
        run: git config --global core.autocrlf false

      - name: Check out current main and Typie
        uses: actions/checkout@v4
        with:
          ref: main
          submodules: recursive
          fetch-depth: 0

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version-file: .node-version

      - name: Activate pinned pnpm
        shell: pwsh
        run: |
          corepack enable
          corepack prepare pnpm@11.9.0 --activate
          pnpm --version
          node --version

      - name: Set up .NET SDK
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: 10.0.400

      - name: Set up pinned Rust toolchain
        shell: pwsh
        run: |
          rustup toolchain install 1.97.1 --profile minimal --component rustfmt --target wasm32-unknown-unknown --target x86_64-pc-windows-msvc
          rustup default 1.97.1
          rustc --version
          cargo --version

      - name: Apply exact Phase 1I-H-A patch
        shell: pwsh
        run: |
          $patchRoot = Join-Path $env:RUNNER_TEMP "madi-phase1i-h-a"
          New-Item -ItemType Directory -Force -Path $patchRoot | Out-Null
          $archive = Join-Path $env:RUNNER_TEMP "madi-phase1i-h-a.zip"
          $parts = Get-ChildItem ".github/phase1i-h-a" -Filter "*.b64" | Sort-Object Name
          if ($parts.Count -eq 0) {
            throw "Phase 1I-H-A patch chunks are missing"
          }
          $encoded = ($parts | ForEach-Object {
            [System.IO.File]::ReadAllText($_.FullName)
          }) -join ""
          [System.IO.File]::WriteAllBytes(
            $archive,
            [System.Convert]::FromBase64String($encoded)
          )
          Expand-Archive -Path $archive -DestinationPath $patchRoot -Force

          $script = Join-Path $patchRoot "madi-phase1i-h-a-patch/apply-phase1i-h-a.mjs"
          $head = (git rev-parse HEAD).Trim()
          $source = [System.IO.File]::ReadAllText($script)
          $source = $source.Replace(
            'const expectedHead = "b745f2eb20340167ae5b285b0aa9aef9fbb9b8f7";',
            "const expectedHead = `"$head`";"
          )
          [System.IO.File]::WriteAllText(
            $script,
            $source,
            [System.Text.UTF8Encoding]::new($false)
          )

          node $script

          Remove-Item ".github/workflows/apply-phase1i-h-a.yml" -Force
          Remove-Item ".github/phase1i-h-a" -Recurse -Force

      - name: Install dependencies
        shell: pwsh
        run: pnpm install --frozen-lockfile

      - name: Run focused desktop verification
        shell: pwsh
        run: |
          pnpm typecheck
          pnpm --filter @madi/desktop exec vitest run `
            tests/llm-multi-block-apply-coordinator.test.ts `
            tests/llm-project-safety-snapshot-bridge.test.ts `
            tests/llm-project-safety-snapshot-app-contract.test.ts `
            tests/llm-multi-block-review-overlay.test.tsx
          pnpm check:repository
          pnpm format:check
          git diff --check

      - name: Amend bootstrap commit into the product commit
        shell: pwsh
        run: |
          if (Test-Path ".github/workflows/apply-phase1i-h-a.yml") {
            throw "Temporary apply workflow was not removed"
          }
          if (Test-Path ".github/phase1i-h-a") {
            throw "Temporary patch chunks were not removed"
          }

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -A

          $message = @"
          feat(llm): enable snapshot-gated multi-block apply

          phase1i-h-apply-run: $env:GITHUB_RUN_ID
          "@
          git commit --amend -m $message.Trim()

          $finalSha = (git rev-parse HEAD).Trim()
          "FINAL_SHA=$finalSha" | Out-File -FilePath $env:GITHUB_ENV -Encoding utf8 -Append
          Write-Host "FINAL_SHA=$finalSha"
          git push origin HEAD:refs/heads/main --force-with-lease="refs/heads/main:${{ github.sha }}"

      - name: Dispatch authoritative Windows verification
        shell: pwsh
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh workflow run windows-private-verify.yml --ref main

          $verifyRun = $null
          for ($attempt = 0; $attempt -lt 60; $attempt += 1) {
            Start-Sleep -Seconds 5
            $runs = gh run list `
              --workflow windows-private-verify.yml `
              --branch main `
              --event workflow_dispatch `
              --limit 20 `
              --json databaseId,headSha,status,conclusion,createdAt | ConvertFrom-Json
            $verifyRun = $runs |
              Where-Object { $_.headSha -eq $env:FINAL_SHA } |
              Sort-Object createdAt -Descending |
              Select-Object -First 1
            if ($verifyRun) {
              break
            }
          }

          if (-not $verifyRun) {
            throw "Could not locate the dispatched verification run for $env:FINAL_SHA"
          }

          Write-Host "FINAL_VERIFY_RUN_ID=$($verifyRun.databaseId)"
          gh run watch $verifyRun.databaseId --exit-status --interval 30
